    ]},
    {"match": "marathon", "steps": [{"text": "Working through the marathon."}, {"sleep": 300}, {"text": "Marathon work done."}]},
    {"match": "This pod is shutting down", "steps": [{"text": "Parked my step for the shutdown."}]},
    {"match": "Write your handoff now", "steps": [{"text": "E2E-HANDOFF: resume work item 42 at the parser, tests are green."}]},
